#!/usr/bin/env python3
"""Dedicated C-fact producer backed by p101-wrapper-audit's Clang pipeline."""

from __future__ import annotations

import os
import sys
from pathlib import Path


def main() -> None:
    audit = Path(__file__).with_name("p101-wrapper-audit")
    os.execv(str(audit), [str(audit), "--emit-module-facts", *sys.argv[1:]])


if __name__ == "__main__":
    main()
