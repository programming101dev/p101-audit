#!/usr/bin/env bash
set -euo pipefail

root="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
build_dir=""
if [ -f "$root/.last-build-dir" ]; then
    build_dir="$(cat "$root/.last-build-dir")"
fi
for candidate in "$build_dir" build-clang build-clang-22 build; do
    [ -n "$candidate" ] || continue
    if [ -x "$root/$candidate/audit-facts" ]; then
        exec "$root/$candidate/audit-facts" "$@"
    fi
done
# The acceptance preflight removes generated build trees on exit, so the
# absence of this executable is a routine state rather than a broken
# checkout. Name the directory: the caller is usually a generator running
# from somewhere else in the workspace, so name the owning repository.
printf 'audit-facts: native executable not built.\n' >&2
printf 'Build it with:\n' >&2
printf '    cd %s\n' "$root" >&2
printf '    cmake -S . -B build -DP101_BUILD_LEVEL=1\n' >&2
printf '    cmake --build build\n' >&2
exit 2
