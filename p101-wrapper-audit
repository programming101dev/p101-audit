def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Find calls that cross outside the local/p101 wrapper boundary.",
    )
    parser.add_argument("paths", nargs="*", default=["."], help="source files or directories to audit")
    parser.add_argument("-j", "--json", action="store_true", help="emit JSON")
    parser.add_argument("-e", "--strict-external", action="store_true", help="treat unmapped external calls as findings")
    parser.add_argument("-a", "--allow", action="append", default=[], metavar="NAME", help="allow an external callee name; may be repeated")
    parser.add_argument("--allow-file", action="append", type=Path, default=[], metavar="FILE", help="read path:function:callee boundary rules from FILE")
    parser.add_argument("--clang", default=os.environ.get("P101_WRAPPER_AUDIT_CLANG", "clang"), help="clang executable")
    parser.add_argument("--compile-db", type=Path, help="compile_commands.json path")
    parser.add_argument("--compile-db-only", action="store_true", help="audit only active source translation units listed in the compile database")
    parser.add_argument("--cflag", action="append", default=[], help="extra compiler flag for files not present in compile_commands.json; may be repeated")
    parser.add_argument("--header-root", action="append", type=Path, default=[], help="root containing p101 headers; may be repeated")
    parser.add_argument("--timeout", type=float, default=CLANG_AST_TIMEOUT_SECONDS, metavar="SECONDS", help=f"per-translation-unit Clang timeout; default {CLANG_AST_TIMEOUT_SECONDS}")
    parser.add_argument("--keep-going", action="store_true", help="continue after translation-unit parse failures and report the skipped files")
    parser.add_argument("--show-inventory", action="store_true", help="print generated wrapper inventory and exit")
    parser.add_argument("--show-inventory-json", action="store_true", help="print generated wrapper inventory as JSON and exit")
    parser.add_argument("--emit-module-facts", action="store_true", help="emit Clang-derived module facts as TSV and exit")
    parser.add_argument("--facts-output", type=Path, metavar="FILE", help="write the v2 Clang fact snapshot while performing the audit")
    parser.add_argument(
        "--active-headers-only",
        action="store_true",
        help="derive header facts only from active translation units instead of parsing every requested header standalone",
    )
    parser.add_argument("--input-manifest", type=Path, metavar="FILE", help="write the admitted-input manifest as JSON")
    parser.add_argument("--instrumentation-output", type=Path, metavar="FILE", help="write per-function tracing, fault, and resource instrumentation coverage as JSON")
    parser.add_argument("--mutation-candidates-output", type=Path, metavar="FILE", help="write safe Clang-located mutation candidates as JSON")
    return parser.parse_args(argv)


def is_under(path: Path, roots: Iterable[Path]) -> bool:
    resolved = path.resolve()
    for root in roots:
        try:
            resolved.relative_to(root.resolve())
            return True
        except ValueError:
            pass
    return False


def is_skipped_dir(path: Path) -> bool:
    name = path.name
    return name in SKIP_DIRS or name.startswith("build-") or name.startswith("coverage-") or name.startswith("debug-") or name.startswith("profile-")


def find_compile_db(start_paths: list[Path]) -> Path | None:
    candidates: list[Path] = []
    for path in start_paths:
        cursor = path if path.is_dir() else path.parent
        for index, parent in enumerate([cursor, *cursor.parents]):
            if index > COMPILE_DB_PARENT_LIMIT:
                break
            candidates.append(parent / "compile_commands.json")
            for build_name in ("build-clang", "build", "build-clang-22"):
                candidates.append(parent / build_name / "compile_commands.json")
            if (parent / ".git").exists():
                break

    seen: set[Path] = set()
    for candidate in candidates:
        if candidate in seen:
            continue
        seen.add(candidate)
        if candidate.is_file():
            return candidate
    return None


def load_compile_db(path: Path | None) -> dict[Path, dict[str, Any]]:
    if path is None or not path.is_file():
        return {}
    data = json.loads(path.read_text(encoding="utf-8"))
    entries: dict[Path, dict[str, Any]] = {}
    for entry in data:
        file_text = entry.get("file")
        if not file_text:
            continue
        directory = Path(entry.get("directory", "."))
        file_path = Path(file_text)
        if not file_path.is_absolute():
            file_path = directory / file_path
        entries[file_path.resolve()] = entry
    return entries


def discover_sources(paths: list[Path], compile_db: dict[Path, dict[str, Any]], compile_db_only: bool = False) -> list[TranslationUnit]:
    roots = [path.resolve() for path in paths]
    sources: dict[Path, TranslationUnit] = {}

    for source, entry in compile_db.items():
        if source.suffix in SOURCE_SUFFIXES and is_under(source, roots):
            command = entry_to_command(entry)
            directory = Path(entry.get("directory", ".")).resolve()
            sources[source] = TranslationUnit(source=source, command=command, directory=directory)

    if not compile_db_only:
        for path in paths:
            if path.is_file() and path.suffix in SOURCE_SUFFIXES:
                sources.setdefault(path.resolve(), TranslationUnit(source=path.resolve(), command=None, directory=path.parent.resolve()))
            elif path.is_dir():
                for dirpath, dirnames, filenames in os.walk(path):
                    dirnames[:] = [name for name in dirnames if not is_skipped_dir(Path(name))]
                    directory = Path(dirpath)
                    for filename in filenames:
                        child = directory / filename
                        if child.suffix in SOURCE_SUFFIXES:
                            sources.setdefault(child.resolve(), TranslationUnit(source=child.resolve(), command=None, directory=child.parent.resolve()))

    return sorted(sources.values(), key=lambda item: str(item.source))


def discover_headers(paths: list[Path]) -> list[Path]:
    headers: set[Path] = set()
    for path in paths:
        if path.is_file() and path.suffix in HEADER_SUFFIXES:
            headers.add(path.resolve())
        elif path.is_dir():
            for dirpath, dirnames, filenames in os.walk(path):
                dirnames[:] = [name for name in dirnames if not is_skipped_dir(Path(name))]
                directory = Path(dirpath)
                for filename in filenames:
                    child = directory / filename
                    if child.suffix in HEADER_SUFFIXES:
                        headers.add(child.resolve())
    return sorted(headers, key=lambda item: str(item))


def entry_to_command(entry: dict[str, Any]) -> list[str] | None:
    if isinstance(entry.get("arguments"), list):
        return [str(arg) for arg in entry["arguments"]]
    if isinstance(entry.get("command"), str):
        return shlex.split(entry["command"])
    return None


def discover_header_include_dirs(header_roots: list[Path]) -> list[Path]:
    """Find installed-style roots and sibling library include directories."""
    include_dirs: set[Path] = set()

    for root in [*header_roots, *DEFAULT_HEADER_ROOTS]:
        if not root.is_dir():
            continue

        resolved = root.resolve()
        if any(child.is_dir() and child.name.startswith("p101_") for child in resolved.iterdir()):
            include_dirs.add(resolved)

        for child in resolved.iterdir():
            include_dir = child / "include"
            if include_dir.is_dir():
                include_dirs.add(include_dir.resolve())

    return sorted(include_dirs, key=str)


def header_compile_flags(
    compile_db: dict[Path, dict[str, Any]],
    requested_paths: list[Path],
    user_flags: list[str],
    header_roots: list[Path],
) -> list[str]:
    """Recover the active project's preprocessing view for standalone headers."""
    flags = list(user_flags)
    command = None
    for entry in compile_db.values():
        command = entry_to_command(entry)
        if command:
            break
    if command:
        paired = {"-D", "-I", "-U", "-include", "-isystem", "-isysroot", "--sysroot"}
        index = 1
        while index < len(command):
            arg = command[index]
            if arg in paired and index + 1 < len(command):
                flags.extend([arg, command[index + 1]])
                index += 2
                continue
            if arg.startswith(("-D", "-I", "-U", "-std=", "--sysroot=")):
                flags.append(arg)
            index += 1

    for path in requested_paths:
        if path.is_dir():
            flags.append(f"-I{path.resolve()}")

    existing_flags = set(flags)
    for include_dir in discover_header_include_dirs(header_roots):
        flag = f"-I{include_dir}"
        if flag not in existing_flags:
            flags.append(flag)
            existing_flags.add(flag)

    return flags


def wrapper_inventory(header_roots: list[Path]) -> dict[str, str]:
    inventory: dict[str, str] = {}
    pattern = re.compile(r"\bp101_([A-Za-z_][A-Za-z0-9_]*)\s*\(")
    roots = [*header_roots, *DEFAULT_HEADER_ROOTS]

    for root in roots:
        if not root.is_dir():
            continue
        for header in root.rglob("*.h"):
            if "p101" not in str(header):
                continue
            try:
                text = header.read_text(encoding="utf-8", errors="ignore")
            except OSError as exc:
                raise RuntimeError(f"could not read header {header}: {exc}") from exc
            for match in pattern.finditer(text):
                original = match.group(1)
                wrapper = f"p101_{original}"
                inventory.setdefault(original, wrapper)

    add_atomic_aliases(inventory)
    return inventory


def add_atomic_aliases(inventory: dict[str, str]) -> None:
    for base in (
        "compare_exchange_strong",
        "compare_exchange_strong_explicit",
        "compare_exchange_weak",
        "compare_exchange_weak_explicit",
        "exchange",
        "exchange_explicit",
        "fetch_add",
        "fetch_add_explicit",
        "fetch_and",
        "fetch_and_explicit",
        "fetch_or",
        "fetch_or_explicit",
        "fetch_sub",
        "fetch_sub_explicit",
        "fetch_xor",
        "fetch_xor_explicit",
        "load",
        "load_explicit",
        "store",
        "store_explicit",
    ):
        wrapper = inventory.get(f"atomic_uint_{base}")
        if wrapper:
            inventory.setdefault(f"atomic_{base}", wrapper)


def clang_ast(command: str, tu: TranslationUnit, extra_cflags: list[str], timeout: float) -> dict[str, Any]:
    if tu.command:
        ast_command = ast_command_from_compile_command(command, tu, extra_cflags)
    else:
        language = language_for(tu.source)
        standard = "c++17" if "c++" in language else "c17"
        ast_command = [command, "-x", language, f"-std={standard}", *extra_cflags, "-fsyntax-only", "-Xclang", "-ast-dump=json", str(tu.source)]

    try:
        proc = subprocess.run(ast_command, cwd=str(tu.directory or tu.source.parent), text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=timeout)
    except subprocess.TimeoutExpired as exc:
        raise RuntimeError(f"clang timed out after {timeout:g}s for {tu.source}") from exc
    if proc.returncode != 0:
        raise RuntimeError(f"clang failed for {tu.source}:\n{proc.stderr}")
    return json.loads(proc.stdout)


def clang_preprocessor_facts(command: str, tu: TranslationUnit, extra_cflags: list[str], roots: list[Path], timeout: float) -> list[tuple[str, Path, int, tuple[object, ...]]]:
    if tu.command:
        preprocess_command = ast_command_from_compile_command(command, tu, extra_cflags)
        preprocess_command = [value for value in preprocess_command if value not in {"-fsyntax-only", "-Xclang", "-ast-dump=json"}]
        preprocess_command.extend(["-E", "-dI", "-dD"])
    else:
        language = language_for(tu.source)
        standard = "c++17" if "c++" in language else "c17"
        preprocess_command = [command, "-x", language, f"-std={standard}", *extra_cflags, "-E", "-dI", "-dD", str(tu.source)]
    try:
        proc = subprocess.run(preprocess_command, cwd=str(tu.directory or tu.source.parent), text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=timeout)
    except subprocess.TimeoutExpired as exc:
        raise RuntimeError(f"clang preprocessor timed out after {timeout:g}s for {tu.source}") from exc
    if proc.returncode != 0:
        raise RuntimeError(f"clang preprocessing failed for {tu.source}:\n{proc.stderr}")

    facts: list[tuple[str, Path, int, tuple[object, ...]]] = []
    current_path: Path | None = None
    current_line = 1
    marker_pattern = re.compile(r'^#\s+(\d+)\s+"([^"]+)"')
    include_pattern = re.compile(r'^#include\s*([<"])([^>"]+)[>"]')
    macro_pattern = re.compile(r"^#define\s+([A-Za-z_][A-Za-z0-9_]*)")
    for output_line in proc.stdout.splitlines():
        marker = marker_pattern.match(output_line)
        if marker:
            marker_text = marker.group(2)
            if marker_text.startswith("<") and marker_text.endswith(">"):
                current_path = None
                current_line = int(marker.group(1))
                continue
            marker_path = Path(marker_text)
            current_path = marker_path.resolve() if marker_path.is_absolute() else (tu.directory / marker_path).resolve()
            current_line = int(marker.group(1))
            continue
        if current_path is None or not is_under(current_path, roots):
            continue
        include = include_pattern.match(output_line)
        if include:
            facts.append(("INCLUDE", current_path, current_line, (include.group(2), bool_text(include.group(1) == '"'))))
        macro = macro_pattern.match(output_line)
        if macro:
            name = macro.group(1)
            if not (len(name) > 2 and name.endswith("_H")):
                facts.append(("MACRO", current_path, current_line, (name,)))
        current_line += 1
    return facts


def ast_command_from_compile_command(command: str, tu: TranslationUnit, extra_cflags: list[str]) -> list[str]:
    original = list(tu.command or [])
    if not original:
        raise ValueError("missing compile command")

    original[0] = command
    result: list[str] = []
    skip_next = False
    for arg in original:
        if skip_next:
            skip_next = False
            continue
        if arg in {"-c", "-o", "-MF", "-MT", "-MQ"}:
            skip_next = arg in {"-o", "-MF", "-MT", "-MQ"}
            if arg == "-c":
                continue
            continue
        if arg.startswith("-o") and arg != "-ObjC":
            continue
        result.append(arg)

    result.extend([*extra_cflags, "-fsyntax-only", "-Xclang", "-ast-dump=json"])
    return result


def language_for(path: Path) -> str:
    if path.suffix == ".c":
        return "c"
    if path.suffix in {".cc", ".cpp", ".cxx"}:
        return "c++"
    if path.suffix in {".hh", ".hpp", ".hxx"}:
        return "c++-header"
    if path.suffix == ".m":
        return "objective-c"
    if path.suffix == ".mm":
        return "objective-c++"
    return "c"


def iter_nodes(node: dict[str, Any]) -> Iterable[dict[str, Any]]:
    yield node
    for child in node.get("inner", []) or []:
        if isinstance(child, dict):
            yield from iter_nodes(child)


def location_file(loc: dict[str, Any]) -> Path | None:
    file_text = loc.get("file")
    if not file_text:
        return None
    return Path(file_text).resolve()


def line_col_from_offset(source_bytes: bytes, offset: int) -> tuple[int, int]:
    line = source_bytes.count(b"\n", 0, offset) + 1
    previous_newline = source_bytes.rfind(b"\n", 0, offset)
    column = offset + 1 if previous_newline < 0 else offset - previous_newline
    return line, column


def spelling_location(node: dict[str, Any], default_file: Path | None = None, source_bytes: bytes | None = None, allow_default_file: bool = True) -> tuple[Path | None, int, int]:
    loc = node.get("loc", {}) or {}
    if "spellingLoc" in loc:
        loc = loc["spellingLoc"]
    file_path = location_file(loc)
    range_begin = ((node.get("range", {}) or {}).get("begin", {}) or {})
    if file_path is None:
        if "expansionLoc" in range_begin:
            range_begin = range_begin["expansionLoc"]
        elif "spellingLoc" in range_begin:
            range_begin = range_begin["spellingLoc"]
        file_path = location_file(range_begin)
        if loc.get("line") is None and range_begin.get("line") is not None:
            loc = range_begin
    line = int(loc.get("line", 0) or 0)
    column = int(loc.get("col", 0) or 0)
    if source_bytes is not None:
        offset = loc.get("offset")
        if offset is None:
            offset = range_begin.get("offset")
        offset_belongs_to_default_file = file_path is None or default_file is None or file_path == default_file
        if isinstance(offset, int) and offset_belongs_to_default_file:
            line, column = line_col_from_offset(source_bytes, offset)
            if allow_default_file and "includedFrom" not in loc and "includedFrom" not in range_begin:
                file_path = file_path or default_file
    return file_path, line, column


def node_offset(node: dict[str, Any]) -> int | None:
    loc = node.get("loc", {}) or {}
    if "spellingLoc" in loc:
        loc = loc["spellingLoc"]
    offset = loc.get("offset")
    if isinstance(offset, int):
        return offset
    range_begin = ((node.get("range", {}) or {}).get("begin", {}) or {})
    if "expansionLoc" in range_begin:
        range_begin = range_begin["expansionLoc"]
    elif "spellingLoc" in range_begin:
        range_begin = range_begin["spellingLoc"]
    offset = range_begin.get("offset")
    return offset if isinstance(offset, int) else None


def range_location(value: dict[str, Any]) -> dict[str, Any]:
    if "expansionLoc" in value:
        return value["expansionLoc"]
    if "spellingLoc" in value:
        return value["spellingLoc"]
    return value


def node_range_offsets(node: dict[str, Any]) -> tuple[int, int] | None:
    node_range = node.get("range", {}) or {}
    begin = range_location(node_range.get("begin", {}) or {})
    end = range_location(node_range.get("end", {}) or {})
    start = begin.get("offset")
    finish = end.get("offset")
    token_length = end.get("tokLen", 1)
    if not isinstance(start, int) or not isinstance(finish, int) or not isinstance(token_length, int):
        return None
    return start, finish + token_length


def spelling_location_with_ancestors(node: dict[str, Any], ancestors: tuple[dict[str, Any], ...], default_file: Path | None = None, source_bytes: bytes | None = None, allow_default_file: bool = True) -> tuple[Path | None, int, int]:
    file_path, line, column = spelling_location(node, default_file, source_bytes, allow_default_file)
    if file_path is not None:
        return file_path, line, column

    for ancestor in reversed(ancestors):
        if ancestor.get("kind") != "FunctionDecl":
            continue
        ancestor_file, _, _ = spelling_location(ancestor, default_file, source_bytes, allow_default_file=False)
        if ancestor_file is None:
            continue
        offset = node_offset(node)
        if offset is not None:
            try:
                line, column = line_col_from_offset(ancestor_file.read_bytes(), offset)
            except OSError:
                pass
        return ancestor_file, line, column

    return file_path, line, column


def iter_nodes_with_ancestors(node: dict[str, Any], ancestors: tuple[dict[str, Any], ...] = ()) -> Iterable[tuple[dict[str, Any], tuple[dict[str, Any], ...]]]:
    yield node, ancestors
    next_ancestors = (*ancestors, node)
    for child in node.get("inner", []) or []:
        if isinstance(child, dict):
            yield from iter_nodes_with_ancestors(child, next_ancestors)


def enclosing_function_name(ancestors: tuple[dict[str, Any], ...]) -> str | None:
    for ancestor in reversed(ancestors):
        if ancestor.get("kind") == "FunctionDecl" and ancestor.get("name") and node_has_body(ancestor):
            return str(ancestor["name"])
    return None


def collect_local_functions(units_and_asts: list[tuple[TranslationUnit, dict[str, Any]]], roots: list[Path]) -> set[str]:
    names: set[str] = set()
    for unit, ast in units_and_asts:
        source_bytes = unit.source.read_bytes()
        for node in iter_nodes(ast):
            if node.get("kind") != "FunctionDecl":
                continue
            if not node_has_body(node):
                continue
            if node.get("storageClass") == "static":
                continue
            name = node.get("name")
            if not name:
                continue
            file_path, _, _ = spelling_location(node, unit.source, source_bytes)
            if file_path is not None and is_under(file_path, roots):
                names.add(str(name))
    return names


def collect_instrumentation(units_and_asts: list[tuple[TranslationUnit, dict[str, Any]]], roots: list[Path]) -> list[dict[str, Any]]:
    records: list[dict[str, Any]] = []
    seen: set[tuple[str, str, int]] = set()
    function_calls: dict[tuple[str, str], set[str | None]] = {}
    function_capabilities: dict[tuple[str, str], dict[str, bool]] = {}
    capability_calls = {
        "trace_entry": {"p101_env_trace"},
        "trace_exit": {"p101_env_trace_exit"},
        "fault": {"p101_env_check_fault", "p101_env_check_fault_action"},
        "fd": {"p101_env_track_open", "p101_env_track_close", "p101_env_track_fork", "p101_env_track_spawn", "p101_env_track_exec", "p101_env_track_exec_failure"},
        "allocation": {"p101_env_track_alloc", "p101_env_track_free", "p101_env_track_realloc"},
        "resource": {"p101_env_track_resource", "p101_env_track_pointer_resource", "p101_env_track_integer_resource"},
    }

    for unit, ast in units_and_asts:
        source_bytes = unit.source.read_bytes()
        for node in iter_nodes(ast):
            if node.get("kind") != "FunctionDecl" or not node_has_body(node):
                continue
            name = str(node.get("name", ""))
            file_path, line, _ = spelling_location(node, unit.source, source_bytes)
            if file_path is None or not is_under(file_path, roots):
                continue
            key = (str(file_path), name, line)
            if key in seen:
                continue
            seen.add(key)
            calls = {call_name(child) for child in iter_nodes(node) if child.get("kind") == "CallExpr"}
            function_key = (str(file_path), name)
            function_calls.setdefault(function_key, set()).update(calls)
            capabilities = function_capabilities.setdefault(function_key, {capability: False for capability in capability_calls})
            for capability, names in capability_calls.items():
                capabilities[capability] = capabilities[capability] or bool(calls & names)
            if not name.startswith("p101_"):
                continue
            record: dict[str, Any] = {
                "path": str(file_path),
                "line": line,
                "function": name,
                "has_env": function_has_parameter_type(node, "p101_env"),
                "has_error": function_has_parameter_type(node, "p101_error"),
            }
            records.append(record)

    changed = True
    while changed:
        changed = False
        for function_key, calls in function_calls.items():
            capabilities = function_capabilities[function_key]
            for callee in calls:
                helper = function_capabilities.get((function_key[0], str(callee)))
                if helper is None:
                    continue
                for capability in capability_calls:
                    if helper[capability] and not capabilities[capability]:
                        capabilities[capability] = True
                        changed = True

    for record in records:
        capabilities = function_capabilities[(record["path"], record["function"])]
        for capability in capability_calls:
            record[capability] = capabilities[capability]
    return sorted(records, key=lambda item: (item["path"], item["line"], item["function"]))


def write_instrumentation(path: Path, records: list[dict[str, Any]]) -> None:
    data = {
        "schema": "p101-instrumentation-coverage-v1",
        "producer": "p101-wrapper-audit",
        "functions": records,
    }
    path.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n", encoding="utf-8")


def collect_mutation_candidates(units_and_asts: list[tuple[TranslationUnit, dict[str, Any]]], roots: list[Path]) -> list[MutationCandidate]:
    comparison_replacements = {"==": "!=", "!=": "==", "<": "<=", "<=": "<", ">": ">=", ">=": ">"}
    predicate_replacements = {"p101_error_has_error": "p101_error_has_no_error", "p101_error_has_no_error": "p101_error_has_error"}
    cleanup_calls = {"p101_close", "p101_fclose", "p101_free"}
    candidates: list[MutationCandidate] = []
    seen: set[tuple[str, int, int, str]] = set()

    for unit, ast in units_and_asts:
        source = unit.source.read_bytes()
        for node, ancestors in iter_nodes_with_ancestors(ast):
            kind = node.get("kind")
            if kind not in {"BinaryOperator", "CallExpr"}:
                continue
            file_path, line, _ = spelling_location_with_ancestors(node, ancestors, unit.source, source)
            if file_path != unit.source or not is_under(file_path, roots):
                continue
            offsets = node_range_offsets(node)
            if offsets is None:
                continue
            start, end = offsets
            if start < 0 or end > len(source) or start >= end:
                continue

            candidate: MutationCandidate | None = None
            if kind == "BinaryOperator" and str(node.get("opcode", "")) in comparison_replacements:
                children = [child for child in node.get("inner", []) or [] if isinstance(child, dict)]
                if len(children) >= 2:
                    left_range = node_range_offsets(children[0])
                    right_range = node_range_offsets(children[1])
                    if left_range is not None and right_range is not None:
                        between_start = left_range[1]
                        between_end = right_range[0]
                        opcode = str(node["opcode"])
                        position = source.find(opcode.encode(), between_start, between_end)
                        if position >= 0:
                            candidate = MutationCandidate("comparison-boundary", str(file_path), line, position, position + len(opcode), opcode, comparison_replacements[opcode])
            elif kind == "CallExpr":
                name = call_name(node)
                if name in predicate_replacements:
                    position = source.find(str(name).encode(), start, end)
                    if position >= 0:
                        candidate = MutationCandidate("error-predicate", str(file_path), line, position, position + len(str(name)), str(name), predicate_replacements[str(name)])
                elif name in cleanup_calls and ancestors and ancestors[-1].get("kind") == "CompoundStmt":
                    original = source[start:end].decode("utf-8", errors="strict")
                    candidate = MutationCandidate("skip-cleanup", str(file_path), line, start, end, original, "(void)0")

            if candidate is not None:
                key = (candidate.path, candidate.start, candidate.end, candidate.replacement)
                if key not in seen:
                    seen.add(key)
                    candidates.append(candidate)

    return sorted(candidates, key=lambda item: (item.path, item.start, item.operator, item.replacement))


def write_mutation_candidates(path: Path, candidates: list[MutationCandidate]) -> None:
    data = {
        "schema": "p101-mutation-candidates-v1",
        "producer": "p101-wrapper-audit",
        "candidates": [candidate.__dict__ for candidate in candidates],
    }
    path.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n", encoding="utf-8")


def call_name(node: dict[str, Any]) -> str | None:
    name, _ = call_target(node)
    return name


def call_target(node: dict[str, Any]) -> tuple[str | None, str | None]:
    if node.get("kind") == "AtomicExpr" and node.get("name"):
        return str(node["name"]), "FunctionDecl"
    referenced = node.get("referencedDecl")
    if isinstance(referenced, dict) and referenced.get("name"):
        return str(referenced["name"]), str(referenced.get("kind", ""))
    inner = node.get("inner", []) or []
    if inner and isinstance(inner[0], dict):
        return declref_info(inner[0])
    return None, None


def canonical_callee_name(name: str) -> str:
    """Map compiler-lowered libc calls back to their source-level boundary."""
    if name.startswith("__c11_atomic_"):
        return f"atomic_{name.removeprefix('__c11_atomic_')}"
    return FORTIFIED_CALLEES.get(name, name)


def call_contract(node: dict[str, Any]) -> tuple[bool, bool]:
    """Return whether the resolved callee signature requires env and error."""
    for candidate in iter_nodes(node):
        referenced = candidate.get("referencedDecl")
        if not isinstance(referenced, dict):
            continue
        type_info = referenced.get("type")
        if not isinstance(type_info, dict):
            continue
        signature = str(type_info.get("qualType", ""))
        if signature:
            parameters = signature.split("(", 1)[1] if "(" in signature else signature
            needs_env = re.search(r"\bstruct\s+p101_env\s*\*", parameters) is not None
            needs_error = re.search(r"\bstruct\s+p101_error\s*\*", parameters) is not None
            return needs_env, needs_error
    return False, False


def node_is_null_pointer(node: dict[str, Any]) -> bool:
    """Recognize a source null pointer after Clang's implicit AST wrapping."""
    if node.get("kind") in {"GNUNullExpr", "CXXNullPtrLiteralExpr"}:
        return True
    if node.get("kind") == "IntegerLiteral" and str(node.get("value", "")) == "0":
        return True
    children = [child for child in node.get("inner", []) or [] if isinstance(child, dict)]
    return len(children) == 1 and node_is_null_pointer(children[0])


def call_discards_error(node: dict[str, Any]) -> bool:
    """p101 APIs consistently place the error object after the environment."""
    needs_env, needs_error = call_contract(node)
    children = [child for child in node.get("inner", []) or [] if isinstance(child, dict)]
    return needs_env and needs_error and len(children) >= 3 and node_is_null_pointer(children[2])


def declref_name(node: dict[str, Any]) -> str | None:
    name, _ = declref_info(node)
    return name


def declref_info(node: dict[str, Any]) -> tuple[str | None, str | None]:
    if node.get("kind") == "MemberExpr" and node.get("name"):
        return str(node["name"]), "FieldDecl"
    referenced = node.get("referencedDecl")
    if isinstance(referenced, dict) and referenced.get("name"):
        return str(referenced["name"]), str(referenced.get("kind", ""))
    for child in node.get("inner", []) or []:
        if isinstance(child, dict):
            name, kind = declref_info(child)
            if name:
                return name, kind
    return None, None


def local_function_pointer_targets(ast: dict[str, Any]) -> dict[tuple[str, str], set[str]]:
    """Collect direct function targets assigned within one function.

    A pointer is resolved only when every observed initializer or assignment
    names the same concrete function. Aliases, parameters, fields, returned
    values, and pointers with competing targets remain explicit boundaries.
    """
    targets: dict[tuple[str, str], set[str]] = {}
    for node, ancestors in iter_nodes_with_ancestors(ast):
        if node.get("kind") != "VarDecl" or not node.get("name"):
            continue
        caller = enclosing_function_name(ancestors)
        if caller is None:
            continue
        names = {
            str(candidate["referencedDecl"]["name"])
            for candidate in iter_nodes(node)
            if candidate.get("kind") == "DeclRefExpr"
            and isinstance(candidate.get("referencedDecl"), dict)
            and candidate["referencedDecl"].get("kind") in {"FunctionDecl", "CXXMethodDecl", "FunctionTemplateDecl"}
            and candidate["referencedDecl"].get("name")
        }
        if names:
            targets.setdefault((caller, str(node["name"])), set()).update(names)
    for node, ancestors in iter_nodes_with_ancestors(ast):
        if node.get("kind") != "BinaryOperator" or node.get("opcode") != "=":
            continue
        caller = enclosing_function_name(ancestors)
        children = [child for child in node.get("inner", []) or [] if isinstance(child, dict)]
        if caller is None or len(children) != 2:
            continue
        variable_name, variable_kind = declref_info(children[0])
        function_names = {
            str(candidate["referencedDecl"]["name"])
            for candidate in iter_nodes(children[1])
            if candidate.get("kind") == "DeclRefExpr"
            and isinstance(candidate.get("referencedDecl"), dict)
            and candidate["referencedDecl"].get("kind") in {"FunctionDecl", "CXXMethodDecl", "FunctionTemplateDecl"}
            and candidate["referencedDecl"].get("name")
        }
        if variable_name and variable_kind == "VarDecl" and function_names:
            targets.setdefault((caller, variable_name), set()).update(function_names)
    return targets


def allow_rule_matches(rule: AllowRule, finding: Finding) -> bool:
    normalized = Path(finding.path).as_posix()
    path_matches = rule.path == "*" or normalized == rule.path or normalized.endswith(f"/{rule.path}")
    function_matches = rule.function == "*" or finding.caller == rule.function
    return path_matches and function_matches and finding.name == rule.callee


def collect_findings(
    units_and_asts: list[tuple[TranslationUnit, dict[str, Any]]],
    roots: list[Path],
    locals_: set[str],
    inventory: dict[str, str],
    allow: set[str],
    allow_rules: list[AllowRule],
) -> list[Finding]:
    findings: list[Finding] = []
    seen: set[tuple[str, int, int, str]] = set()

    for unit, ast in units_and_asts:
        source_bytes = unit.source.read_bytes()
        pointer_targets = local_function_pointer_targets(ast)
        unit_local_functions = {
            str(candidate["name"])
            for candidate in iter_nodes(ast)
            if candidate.get("kind") == "FunctionDecl" and candidate.get("name") and node_has_body(candidate)
        }
        for node, ancestors in iter_nodes_with_ancestors(ast):
            if node.get("kind") not in {"CallExpr", "AtomicExpr"}:
                continue
            name, target_kind = call_target(node)
            if not name:
                continue
            caller = enclosing_function_name(ancestors) or "?"
            if target_kind not in {None, "", "FunctionDecl", "CXXMethodDecl", "FunctionTemplateDecl"}:
                resolved = pointer_targets.get((caller, name), set())
                if len(resolved) == 1:
                    name        = next(iter(resolved))
                    target_kind = "FunctionDecl"
            name = canonical_callee_name(name)
            if name in CONTROL_CALLEES or name.startswith("__") or name.startswith("_OSSwap") or name.startswith("p101_") or name in unit_local_functions or name in locals_ or name in allow:
                continue
            is_indirect = target_kind not in {None, "", "FunctionDecl", "CXXMethodDecl", "FunctionTemplateDecl"}
            wrapper = "" if is_indirect else inventory.get(name, "")
            if wrapper and caller == wrapper:
                continue
            replacement = wrapper
            file_path, line, column = spelling_location_with_ancestors(node, ancestors, unit.source, source_bytes)
            if file_path is None or not is_under(file_path, roots):
                continue

            if is_indirect:
                kind = "indirect-call"
                category = "indirect"
            else:
                kind = "missed-wrapper" if replacement else "external-call"
                category = "wrapped" if replacement else "external"
            hint = replacement_hint(name, replacement, is_indirect)
            key = (str(file_path), line, column, name)
            if key in seen:
                continue
            seen.add(key)
            finding = Finding(
                diagnostic_id=diagnostic_id_for_kind(kind),
                path=str(file_path),
                line=line,
                column=column,
                name=name,
                caller=caller,
                kind=kind,
                replacement=replacement,
                category=category,
                hint=hint,
            )
            matched = False
            for rule in allow_rules:
                if allow_rule_matches(rule, finding):
                    rule.used = True
                    matched = True
            if not matched:
                findings.append(finding)

    return sorted(findings, key=lambda item: (item.path, item.line, item.column, item.name))


def diagnostic_id_for_kind(kind: str) -> str:
    return {
        "missed-wrapper": "P101-WRAP-001",
        "external-call": "P101-WRAP-002",
        "indirect-call": "P101-WRAP-003",
    }.get(kind, "P101-WRAP-000")


def replacement_hint(name: str, replacement: str, is_indirect: bool = False) -> str:
    if replacement:
        return f"use {replacement}(env, err, ...) instead of raw {name}(...) when the surrounding code is p101-aware"
    if is_indirect:
        return f"indirect/non-p101 call through {name}; wrapper-audit cannot prove the runtime target, so keep this at a documented boundary"
    return "external/non-p101 call; allow it explicitly, wrap it, or keep it at a documented boundary"


def print_inventory(inventory: dict[str, str]) -> None:
    for original, wrapper in sorted(inventory.items()):
        print(f"{original}\t{wrapper}")


def print_inventory_json(inventory: dict[str, str]) -> None:
    data = {
        "schema": "p101-wrapper-inventory-v1",
        "wrappers": [{"original": original, "wrapper": wrapper} for original, wrapper in sorted(inventory.items())],
    }
    print(json.dumps(data, indent=2, sort_keys=True))


def print_text(findings: list[Finding], parse_failures: list[ParseFailure] | None = None) -> None:
    parse_failures = parse_failures or []
    missed = sum(1 for finding in findings if finding.kind == "missed-wrapper")
    external = sum(1 for finding in findings if finding.kind == "external-call")
    indirect = sum(1 for finding in findings if finding.kind == "indirect-call")
    print("p101-wrapper-audit summary")
    print(f"missed_wrappers: {missed}")
    print(f"external_calls: {external}")
    print(f"indirect_calls: {indirect}")
    print(f"parse_failures: {len(parse_failures)}")
    for failure in parse_failures:
        print(f"{failure.path}: P101-WRAP-900: parse-failure")
        print(f"  hint: {failure.message}")
    for finding in findings:
        location = f"{finding.path}:{finding.line}:{finding.column}"
        if finding.kind == "missed-wrapper":
            print(f"{location}: {finding.diagnostic_id}: missed-wrapper: {finding.name} -> {finding.replacement} [{finding.caller}]")
            print(f"  hint: {finding.hint}")
        elif finding.kind == "indirect-call":
            print(f"{location}: {finding.diagnostic_id}: indirect-call: {finding.name} [{finding.caller}]")
            print(f"  hint: {finding.hint}")
        else:
            print(f"{location}: {finding.diagnostic_id}: external-call: {finding.name} [{finding.caller}]")
            print(f"  hint: {finding.hint}")


def print_json(findings: list[Finding], parse_failures: list[ParseFailure] | None = None) -> None:
    parse_failures = parse_failures or []
    finding_rows = []
    for finding in findings:
        row = {
            "id": finding.diagnostic_id,
            "severity": "error" if finding.kind == "missed-wrapper" else "note",
            "location": {"path": finding.path, "line": finding.line, "column": finding.column, "function": finding.caller},
            "message": finding.hint,
            "evidence": {
                "parser": "clang-ast",
                "kind": finding.kind,
                "callee": finding.name,
                "replacement": finding.replacement or None,
                "category": finding.category,
            },
        }
        finding_rows.append(row)
    data = {
        "schema": "p101-wrapper-audit-findings-v1",
        "missed_wrappers": sum(1 for finding in findings if finding.kind == "missed-wrapper"),
        "external_calls": sum(1 for finding in findings if finding.kind == "external-call"),
        "indirect_calls": sum(1 for finding in findings if finding.kind == "indirect-call"),
        "parse_failures": len(parse_failures),
        "findings": finding_rows,
        "parse_failure_details": [{"diagnostic_id": "P101-WRAP-900", **failure.__dict__} for failure in parse_failures],
    }
    print(json.dumps(data, indent=2, sort_keys=True))


def module_name_for(path: Path) -> str:
    parts = path.with_suffix("").parts
    for boundary in ("src", "include"):
        if boundary not in parts:
            continue
        boundary_index = len(parts) - 1 - tuple(reversed(parts)).index(boundary)
        module_parts = list(parts[boundary_index + 1 :])
        if boundary == "include" and len(module_parts) > 1 and module_parts[0].startswith("p101_"):
            module_parts.pop(0)
        if module_parts:
            return "/".join(module_parts)
    return path.stem


def bool_text(value: bool) -> str:
    return "1" if value else "0"


def tsv_field(value: object) -> str:
    text = str(value)
    return text.replace("\\", "\\\\").replace("\t", "\\t").replace("\n", "\\n").replace("\r", "\\r")


def print_fact(kind: str, path: Path, line: int, *fields: object) -> None:
    is_header = path.suffix in HEADER_SUFFIXES
    row = [
        "P101FACT",
        "2",
        kind,
        str(path),
        module_name_for(path),
        bool_text(is_header),
        str(line),
        *[tsv_field(field) for field in fields],
    ]
    print("\t".join(row))


def source_line_facts(path: Path) -> Iterable[tuple[str, int, tuple[object, ...]]]:
    text = path.read_text(encoding="utf-8", errors="ignore")
    for line_number, line in enumerate(text.splitlines(), start=1):
        stripped = line.strip()
        if path.suffix not in HEADER_SUFFIXES:
            if "P101_ERROR_CONTRACT_ALLOW_NO_ERROR" in stripped:
                yield ("NOTE", line_number, ("ERROR_OPTIONAL",))


def load_allow_files(paths: list[Path]) -> list[AllowRule]:
    rules: list[AllowRule] = []
    for path in paths:
        for line_number, line in enumerate(path.read_text(encoding="utf-8").splitlines(), start=1):
            value = line.split("#", 1)[0].strip()
            if not value:
                continue
            fields = value.split(":")
            if len(fields) != 3 or any(not field.strip() for field in fields):
                raise ValueError(f"{path}:{line_number}: expected path:function:callee")
            source_path, function, callee = (field.strip() for field in fields)
            rules.append(AllowRule(path=source_path, function=function, callee=callee, source=str(path), line=line_number))
    return rules


def node_has_body(node: dict[str, Any]) -> bool:
    for child in node.get("inner", []) or []:
        if not isinstance(child, dict):
            continue
        if child.get("kind") == "CompoundStmt":
            return True
        if node_has_body(child):
            return True
    return False


def node_is_static_function(node: dict[str, Any]) -> bool:
    return node.get("storageClass") == "static"


def node_type_text(node: dict[str, Any]) -> str:
    type_info = node.get("type")
    if isinstance(type_info, dict):
        return str(type_info.get("qualType", ""))
    return ""


def function_has_parameter_type(node: dict[str, Any], needle: str) -> bool:
    for child in node.get("inner", []) or []:
        if not isinstance(child, dict):
            continue
        if child.get("kind") == "ParmVarDecl" and needle in node_type_text(child):
            return True
    return False


def is_error_query_name(name: str | None) -> bool:
    return bool(name and (name.startswith("p101_error_has_") or name.startswith("p101_error_is_")))


def is_flow_fallible_call(call: dict[str, Any]) -> bool:
    needs_env, needs_error = call_contract(call)
    return needs_env and needs_error and not call_discards_error(call)


def call_argument_object(call: dict[str, Any], argument_index: int) -> str:
    children = [child for child in call.get("inner", []) or [] if isinstance(child, dict)]
    ast_index = argument_index + 1
    if ast_index >= len(children):
        return "?"
    name, kind = declref_info(children[ast_index])
    return name if name is not None and kind in {"ParmVarDecl", "VarDecl"} else "?"


def expression_error_flow(node: dict[str, Any], pending: set[str], unit: TranslationUnit, source_bytes: bytes) -> tuple[set[str], list[tuple[str, int]]]:
    findings: list[tuple[str, int]] = []
    pending = set(pending)
    calls = [candidate for candidate in iter_nodes(node) if candidate.get("kind") == "CallExpr"]
    calls.sort(key=lambda candidate: node_offset(candidate) if node_offset(candidate) is not None else sys.maxsize)
    for call in calls:
        name = call_name(call)
        if is_error_query_name(name):
            pending.discard(call_argument_object(call, 0))
            continue
        if not is_flow_fallible_call(call):
            continue
        error_object = call_argument_object(call, 1)
        if error_object in pending:
            _, line, _ = spelling_location(call, unit.source, source_bytes)
            findings.append(("ERROR_UNCHECKED_CHAIN", line or 1))
        pending.add(error_object)
    return pending, findings


def statement_error_flow(node: dict[str, Any], pending: set[str], unit: TranslationUnit, source_bytes: bytes) -> tuple[set[str], list[tuple[str, int]]]:
    kind = node.get("kind")
    children = [child for child in node.get("inner", []) or [] if isinstance(child, dict)]
    findings: list[tuple[str, int]] = []

    if kind == "CompoundStmt":
        for child in children:
            pending, child_findings = statement_error_flow(child, pending, unit, source_bytes)
            findings.extend(child_findings)
        return pending, findings

    if kind == "IfStmt" and children:
        condition_pending, condition_findings = expression_error_flow(children[0], pending, unit, source_bytes)
        findings.extend(condition_findings)
        then_pending, then_findings = statement_error_flow(children[1], condition_pending, unit, source_bytes) if len(children) > 1 else (condition_pending, [])
        else_pending, else_findings = statement_error_flow(children[2], condition_pending, unit, source_bytes) if len(children) > 2 else (condition_pending, [])
        findings.extend(then_findings)
        findings.extend(else_findings)
        return then_pending | else_pending, findings

    if kind == "ReturnStmt":
        if children:
            _, return_findings = expression_error_flow(children[0], pending, unit, source_bytes)
            findings.extend(return_findings)
        return set(), findings

    if kind in {"ForStmt", "WhileStmt", "DoStmt", "SwitchStmt", "CaseStmt", "DefaultStmt"}:
        # These nodes need a full CFG to merge loop back-edges and case
        # fallthrough precisely. Audit their bodies independently, but do not
        # invent a sequential path across the boundary.
        for child in children:
            _, child_findings = statement_error_flow(child, pending, unit, source_bytes)
            findings.extend(child_findings)
        return pending, findings

    return expression_error_flow(node, pending, unit, source_bytes)


def function_error_flow_notes(node: dict[str, Any], unit: TranslationUnit, source_bytes: bytes) -> list[tuple[str, int]]:
    body = next((child for child in node.get("inner", []) or [] if isinstance(child, dict) and child.get("kind") == "CompoundStmt"), None)
    if body is None:
        return []
    _, lines = statement_error_flow(body, set(), unit, source_bytes)
    return sorted(set(lines), key=lambda item: (item[1], item[0]))


def collect_module_facts(
    units_and_asts: list[tuple[TranslationUnit, dict[str, Any]]],
    roots: list[Path],
    preprocessing_facts: list[tuple[str, Path, int, tuple[object, ...]]] | None = None,
) -> list[tuple[str, Path, int, tuple[object, ...]]]:
    facts: list[tuple[str, Path, int, tuple[object, ...]]] = []
    seen: set[tuple[str, str, int, tuple[object, ...]]] = set()

    for kind, path, line, fields in preprocessing_facts or []:
        key = (kind, str(path), line, fields)
        if key not in seen:
            seen.add(key)
            facts.append((kind, path, line, fields))

    for unit, ast in units_and_asts:
        source_bytes = unit.source.read_bytes()
        for path_fact in source_line_facts(unit.source):
            kind, line, fields = path_fact
            key = (kind, str(unit.source), line, fields)
            if key not in seen:
                seen.add(key)
                facts.append((kind, unit.source, line, fields))

        for node, ancestors in iter_nodes_with_ancestors(ast):
            kind = node.get("kind")
            if kind not in {"FunctionDecl", "CallExpr", "TypedefDecl", "RecordDecl", "ParmVarDecl", "VarDecl"}:
                continue

            unit_is_header = unit.source.suffix in HEADER_SUFFIXES
            allow_default_file = kind in {"CallExpr", "ParmVarDecl", "VarDecl"} or (unit_is_header and kind in {"FunctionDecl", "TypedefDecl", "RecordDecl"}) or (kind == "FunctionDecl" and node_has_body(node))
            file_path, line, _ = spelling_location(node, unit.source, source_bytes, allow_default_file=allow_default_file)
            if file_path is None or not is_under(file_path, roots):
                continue
            line = line or 1
            is_header = file_path.suffix in HEADER_SUFFIXES

            if kind == "FunctionDecl":
                name = node.get("name")
                if not name:
                    continue
                is_definition = node_has_body(node)
                if is_definition or is_header:
                    fields = (str(name), bool_text(node_is_static_function(node)), bool_text(is_header and not is_definition))
                    key = ("FUNCTION", str(file_path), line, fields)
                    if key not in seen:
                        seen.add(key)
                        facts.append(("FUNCTION", file_path, line, fields))
                    if function_has_parameter_type(node, "p101_env"):
                        fields = ("ENV_CONTRACT",)
                        key = ("NOTE", str(file_path), line, fields)
                        if key not in seen:
                            seen.add(key)
                            facts.append(("NOTE", file_path, line, fields))
                    if function_has_parameter_type(node, "p101_error"):
                        fields = ("ERROR_CONTRACT",)
                        key = ("NOTE", str(file_path), line, fields)
                        if key not in seen:
                            seen.add(key)
                            facts.append(("NOTE", file_path, line, fields))
                    for note_kind, finding_line in function_error_flow_notes(node, unit, source_bytes):
                        fields = (note_kind,)
                        key = ("NOTE", str(file_path), finding_line, fields)
                        if key not in seen:
                            seen.add(key)
                            facts.append(("NOTE", file_path, finding_line, fields))
                continue

            if kind == "CallExpr":
                name = call_name(node)
                if name:
                    needs_env, needs_error = call_contract(node)
                    fields = (name, bool_text(needs_env), bool_text(needs_error))
                    key = ("CALL", str(file_path), line, fields)
                    if key not in seen:
                        seen.add(key)
                        facts.append(("CALL", file_path, line, fields))
                    if call_discards_error(node):
                        fields = ("ERROR_DISCARD",)
                        key = ("NOTE", str(file_path), line, fields)
                        if key not in seen:
                            seen.add(key)
                            facts.append(("NOTE", file_path, line, fields))
                    if name in {"p101_env_trace", "p101_env_trace_exit"}:
                        fields = ("TRACE_USE",)
                        key = ("NOTE", str(file_path), line, fields)
                        if key not in seen:
                            seen.add(key)
                            facts.append(("NOTE", file_path, line, fields))
                    if is_error_query_name(name):
                        fields = ("ERROR_CHECK",)
                        key = ("NOTE", str(file_path), line, fields)
                        if key not in seen:
                            seen.add(key)
                            facts.append(("NOTE", file_path, line, fields))
                    if any(ancestor.get("kind") == "ReturnStmt" for ancestor in ancestors):
                        fields = ("ERROR_PROPAGATED",)
                        key = ("NOTE", str(file_path), line, fields)
                        if key not in seen:
                            seen.add(key)
                            facts.append(("NOTE", file_path, line, fields))
                continue

            if is_header and kind in {"TypedefDecl", "RecordDecl"}:
                name = node.get("name")
                if name and not node.get("isImplicit", False):
                    fields = (str(name),)
                    key = ("TYPE", str(file_path), line, fields)
                    if key not in seen:
                        seen.add(key)
                        facts.append(("TYPE", file_path, line, fields))
                continue

            if not is_header and kind in {"ParmVarDecl", "VarDecl"}:
                type_text = node_type_text(node)
                if "p101_env" in type_text:
                    fields = ("ENV_USE",)
                    key = ("NOTE", str(file_path), line, fields)
                    if key not in seen:
                        seen.add(key)
                        facts.append(("NOTE", file_path, line, fields))
                if "p101_error" in type_text:
                    fields = ("ERROR_USE",)
                    key = ("NOTE", str(file_path), line, fields)
                    if key not in seen:
                        seen.add(key)
                        facts.append(("NOTE", file_path, line, fields))

    return sorted(facts, key=lambda item: (str(item[1]), item[2], item[0], item[3]))


def print_module_facts(units: list[TranslationUnit], facts: list[tuple[str, Path, int, tuple[object, ...]]]) -> None:
    emitted_files: set[Path] = set()
    for unit in sorted(units, key=lambda item: str(item.source)):
        emitted_files.add(unit.source)
        print_fact("FILE", unit.source, 0)
    for kind, path, line, fields in facts:
        if path not in emitted_files and path.suffix in HEADER_SUFFIXES:
            emitted_files.add(path)
            print_fact("FILE", path, 0)
        print_fact(kind, path, line, *fields)


def write_module_facts(path: Path, units: list[TranslationUnit], facts: list[tuple[str, Path, int, tuple[object, ...]]]) -> None:
    with path.open("w", encoding="utf-8") as stream:
        with contextlib.redirect_stdout(stream):
            print_module_facts(units, facts)


def sha256_file(path: Path | None) -> str | None:
    if path is None:
        return None
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        while chunk := stream.read(1024 * 1024):
            digest.update(chunk)
    return digest.hexdigest()


def write_input_manifest(
    path: Path,
    requested_paths: list[Path],
    compile_db_path: Path | None,
    compile_db_only: bool,
    clang: str,
    facts_path: Path | None,
    allow_files: list[Path],
    allowed_callees: set[str],
    active_units: list[TranslationUnit],
    parsed_units: list[TranslationUnit],
    parse_failures: list[ParseFailure],
) -> None:
    all_sources = {unit.source for unit in discover_sources(requested_paths, {}, False)}
    all_headers = set(discover_headers(requested_paths))
    active_sources = {unit.source for unit in active_units if unit.source.suffix in SOURCE_SUFFIXES}
    parsed_sources = {unit.source for unit in parsed_units if unit.source.suffix in SOURCE_SUFFIXES}
    parsed_headers = {unit.source for unit in parsed_units if unit.source.suffix in HEADER_SUFFIXES}
    compiler_path = shutil.which(clang)
    if compile_db_only:
        selection_mode = "compile-database-only"
    elif compile_db_path is not None:
        selection_mode = "compile-database-plus-requested-paths"
    else:
        selection_mode = "requested-paths"
    data = {
        "schema": "p101-audit-inputs-v2",
        "producer": "p101-wrapper-audit",
        "compiler": str(Path(compiler_path).resolve()) if compiler_path is not None else clang,
        "selection_mode": selection_mode,
        "compile_database": str(compile_db_path.resolve()) if compile_db_path is not None else None,
        "compile_database_sha256": sha256_file(compile_db_path),
        "fact_snapshot": str(facts_path.resolve()) if facts_path is not None else None,
        "fact_snapshot_sha256": sha256_file(facts_path) if facts_path is not None else None,
        "allowed_callees": sorted(allowed_callees),
        "boundary_rule_files": [
            {"path": str(item.resolve()), "sha256": sha256_file(item)}
            for item in sorted(allow_files, key=lambda value: str(value.resolve()))
        ],
        "requested_paths": [str(item.resolve()) for item in requested_paths],
        "discovered_source_files": [str(item) for item in sorted(all_sources, key=str)],
        "discovered_header_files": [str(item) for item in sorted(all_headers, key=str)],
        "active_translation_units": [str(item) for item in sorted(active_sources, key=str)],
        "inactive_source_files": [str(item) for item in sorted(all_sources - active_sources, key=str)],
        "parsed_translation_units": [str(item) for item in sorted(parsed_sources, key=str)],
        "parsed_headers": [str(item) for item in sorted(parsed_headers, key=str)],
        "unparsed_active_translation_units": [str(item) for item in sorted(active_sources - parsed_sources, key=str)],
        "parse_failures": [failure.__dict__ for failure in parse_failures],
    }
    path.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n", encoding="utf-8")


def main(argv: list[str]) -> int:
    args = parse_args(argv)
    if args.timeout <= 0:
        print("p101-wrapper-audit: --timeout must be greater than zero", file=sys.stderr)
        return 2
    if args.compile_db_only and args.compile_db is None:
        print("p101-wrapper-audit: --compile-db-only requires --compile-db", file=sys.stderr)
        return 2
    if args.emit_module_facts and args.facts_output is not None:
        print("p101-wrapper-audit: --emit-module-facts and --facts-output are mutually exclusive", file=sys.stderr)
        return 2
    try:
        allowed = set(args.allow)
        allow_rules = load_allow_files(args.allow_file)
    except (OSError, ValueError) as exc:
        print(f"p101-wrapper-audit: could not read allow file: {exc}", file=sys.stderr)
        return 2
    paths = [Path(path).resolve() for path in args.paths]
    try:
        inventory = wrapper_inventory(args.header_root)
    except RuntimeError as exc:
        print(f"p101-wrapper-audit: {exc}", file=sys.stderr)
        return 2

    if args.show_inventory:
        print_inventory(inventory)
        return 0

    if args.show_inventory_json:
        print_inventory_json(inventory)
        return 0

    if not args.emit_module_facts and not inventory:
        print("p101-wrapper-audit: wrapper inventory is empty", file=sys.stderr)
        print("p101-wrapper-audit: pass --header-root or install/build the p101 wrapper headers first.", file=sys.stderr)
        return 2

    if args.compile_db is not None and not args.compile_db.is_file():
        print(f"p101-wrapper-audit: compile database does not exist: {args.compile_db}", file=sys.stderr)
        return 2

    compile_db_path = args.compile_db or find_compile_db(paths)
    try:
        compile_db = load_compile_db(compile_db_path)
    except json.JSONDecodeError as exc:
        print(f"p101-wrapper-audit: invalid compile database JSON: {exc}", file=sys.stderr)
        return 2
    units = discover_sources(paths, compile_db, args.compile_db_only)
    active_units = list(units)
    if (args.emit_module_facts or args.facts_output is not None) and not args.active_headers_only:
        existing = {unit.source for unit in units}
        units.extend(TranslationUnit(source=header, command=None, directory=header.parent) for header in discover_headers(paths) if header not in existing)
        units = sorted(units, key=lambda item: str(item.source))
    if not units:
        print("p101-wrapper-audit: no source translation units found", file=sys.stderr)
        return 2

    if args.compile_db is not None:
        missing_commands = [unit.source for unit in units if unit.command is None and unit.source.suffix in SOURCE_SUFFIXES]
        if missing_commands:
            print(f"p101-wrapper-audit: compile database has no command for {missing_commands[0]}", file=sys.stderr)
            print("p101-wrapper-audit: rebuild the target or pass the compile_commands.json that matches these sources.", file=sys.stderr)
            return 2

    units_and_asts: list[tuple[TranslationUnit, dict[str, Any]]] = []
    preprocessing_facts: list[tuple[str, Path, int, tuple[object, ...]]] = []
    parse_failures: list[ParseFailure] = []
    header_cflags = header_compile_flags(compile_db, paths, args.cflag, args.header_root)
    source_cflags = header_compile_flags({}, paths, args.cflag, args.header_root)
    for unit in units:
        try:
            extra_flags = source_cflags if unit.command is not None else header_cflags
            units_and_asts.append((unit, clang_ast(args.clang, unit, extra_flags, args.timeout)))
            if args.emit_module_facts or args.facts_output is not None:
                preprocessing_facts.extend(clang_preprocessor_facts(args.clang, unit, extra_flags, paths, args.timeout))
        except (OSError, RuntimeError, json.JSONDecodeError) as exc:
            message = str(exc)
            parse_failures.append(ParseFailure(path=str(unit.source), message=message))
            if not args.keep_going:
                print(f"p101-wrapper-audit: {message}", file=sys.stderr)
                if args.compile_db is not None:
                    print("p101-wrapper-audit: the compile database may be stale or from a different build tree.", file=sys.stderr)
                return 2

    if parse_failures and args.keep_going:
        for failure in parse_failures:
            print(f"p101-wrapper-audit: skipped {failure.path}: {failure.message}", file=sys.stderr)
        if not units_and_asts:
            return 2

    if args.emit_module_facts:
        parsed_units = [unit for unit, _ in units_and_asts]
        print_module_facts(parsed_units, collect_module_facts(units_and_asts, paths, preprocessing_facts))
        return 2 if parse_failures else 0

    parsed_units = [unit for unit, _ in units_and_asts]
    if args.facts_output is not None:
        try:
            write_module_facts(args.facts_output, parsed_units, collect_module_facts(units_and_asts, paths, preprocessing_facts))
        except OSError as exc:
            print(f"p101-wrapper-audit: could not write facts: {exc}", file=sys.stderr)
            return 2
    if args.input_manifest is not None:
        try:
            write_input_manifest(args.input_manifest, paths, compile_db_path, args.compile_db_only, args.clang, args.facts_output, args.allow_file, allowed, active_units, parsed_units, parse_failures)
        except OSError as exc:
            print(f"p101-wrapper-audit: could not write input manifest: {exc}", file=sys.stderr)
            return 2
    if args.instrumentation_output is not None:
        try:
            write_instrumentation(args.instrumentation_output, collect_instrumentation(units_and_asts, paths))
        except OSError as exc:
            print(f"p101-wrapper-audit: could not write instrumentation coverage: {exc}", file=sys.stderr)
            return 2
    if args.mutation_candidates_output is not None:
        try:
            write_mutation_candidates(args.mutation_candidates_output, collect_mutation_candidates(units_and_asts, paths))
        except (OSError, UnicodeDecodeError) as exc:
            print(f"p101-wrapper-audit: could not write mutation candidates: {exc}", file=sys.stderr)
            return 2

    local_functions = collect_local_functions(units_and_asts, paths)
    findings = collect_findings(units_and_asts, paths, local_functions, inventory, allowed, allow_rules)

    unused_rules = [rule for rule in allow_rules if not rule.used]
    if unused_rules:
        for rule in unused_rules:
            print(f"p101-wrapper-audit: stale boundary rule {rule.source}:{rule.line}: {rule.path}:{rule.function}:{rule.callee}", file=sys.stderr)
        return 2

    if args.json:
        print_json(findings, parse_failures)
    else:
        print_text(findings, parse_failures)

    missed = any(finding.kind == "missed-wrapper" for finding in findings)
    external = any(finding.kind == "external-call" for finding in findings)
    indirect = any(finding.kind == "indirect-call" for finding in findings)
    if parse_failures:
        return 2
    if missed or (args.strict_external and (external or indirect)):
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
