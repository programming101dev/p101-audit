#!/usr/bin/env python3
"""Audit calls that bypass the p101 wrapper boundary.

This tool intentionally uses Clang as the C/C++ parser. It does not try to
token-scan C. The workflow is:

1. inventory p101 wrapper functions from p101 headers;
2. parse target translation units with `clang -ast-dump=json`;
3. collect local functions from files under the audited roots;
4. report calls to non-local, non-p101 functions.

Known wrapped calls are `missed-wrapper` findings and fail the run. Other
external calls are reported as inventory unless --strict-external is used.
"""

from __future__ import annotations

import argparse
import contextlib
import hashlib
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path
from typing import Any, Iterable


SOURCE_SUFFIXES = {".c", ".cc", ".cpp", ".cxx", ".m", ".mm"}
HEADER_SUFFIXES = {".h", ".hh", ".hpp", ".hxx"}
CLANG_AST_TIMEOUT_SECONDS = 30
COMPILE_DB_PARENT_LIMIT = 8
SKIP_DIRS = {
    ".git",
    ".hg",
    ".svn",
    "__pycache__",
    "build",
    "coverage",
    "debug",
    "dist",
    "profile",
}
CONTROL_CALLEES = {
    "__builtin_va_arg",
    "__builtin_choose_expr",
    "__builtin_offsetof",
    "__errno_location",
    "__error",
}
FORTIFIED_CALLEES = {
    "__builtin___fprintf_chk": "fprintf",
    "__builtin___memcpy_chk": "memcpy",
    "__builtin___memmove_chk": "memmove",
    "__builtin___memset_chk": "memset",
    "__builtin___printf_chk": "printf",
    "__builtin___snprintf_chk": "snprintf",
    "__builtin___sprintf_chk": "sprintf",
    "__builtin___stpcpy_chk": "stpcpy",
    "__builtin___stpncpy_chk": "stpncpy",
    "__builtin___strcat_chk": "strcat",
    "__builtin___strcpy_chk": "strcpy",
    "__builtin___strncat_chk": "strncat",
    "__builtin___strncpy_chk": "strncpy",
    "__builtin___memccpy_chk": "memccpy",
    "__builtin___vfprintf_chk": "vfprintf",
    "__builtin___vprintf_chk": "vprintf",
    "__builtin___vsnprintf_chk": "vsnprintf",
    "__builtin___vsprintf_chk": "vsprintf",
    "__builtin_memcpy": "memcpy",
    "__builtin_memmove": "memmove",
    "__builtin_memset": "memset",
